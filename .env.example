# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit .env ขึ้น GitHub)
# บน Render.com ให้ใส่ค่าเหล่านี้ที่ Dashboard → Environment แทน

# รหัส MongoDB Atlas (เฉพาะ Render — ถ้ารันด้วย docker compose ไม่ต้องใส่)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aeris_db?retryWrites=true&w=majority

# คีย์ลับสำหรับเซ็น JWT (สุ่มยาว ๆ)
JWT_SECRET=change_me_to_a_long_random_string

# บัญชีผู้ดูแลระบบ  รูปแบบ "รหัสพนักงาน:รหัสผ่าน" คั่นด้วย ,
ADMIN_ACCOUNTS=67160320:CHANGE_ME,67160235:CHANGE_ME

# จำนวน orders จำลองสำหรับหน้า Indexing (Atlas free tier แนะนำ 100000)
ORDER_SEED_COUNT=100000
